# Root .gitignore for MeetMind AI

# IDE & OS Files
.idea/
.vscode/
*.swp
*.iml
.DS_Store
Thumbs.db
*.log

# Java / Spring Boot Backend
meetmind-backend/target/
meetmind-backend/uploads/
*.class
*.jar
*.war

# Android
android/.gradle/
android/app/build/
android/build/
android/.navigation/
android/captures/
android/.externalNativeBuild/
android/.cxx/
android/local.properties
*.apk
*.aab
*.keystore

# Node.js / React Web Dashboard
web/node_modules/
web/build/
web/dist/
web/.next/
web/.cache/
web/.env.local
web/.env.development.local
web/.env.test.local
web/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secrets
.env
*.env
application-local.yml
application-secrets.yml
